{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run preview:*)",
      "Bash(npm run images:*)",
      "Bash(npm run stats:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite:*)",
      "Bash(node scripts/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(scripts/generate-images.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git add cv_sercanerhan_*:*)",
      "Bash(git add -f:*)"
    ]
  }
}
